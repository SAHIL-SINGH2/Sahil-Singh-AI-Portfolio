# GEMINI_API_KEY: Optional for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Required for Groq AI API (Llama-3.3-70b-versatile)
GROQ_API_KEY="your_groq_api_key_here"

# FASTAPI_URL: URL of your Python FastAPI backend (e.g., http://localhost:8000)
FASTAPI_URL="http://localhost:8000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

