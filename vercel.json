{
  "functions": {
    "api/index.ts": {
      "includeFiles": "{server.js,**/*.pdf,public/**,frontend/public/**,backend/**,frontend/src/data/parsedProfile.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/chat",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
