{
  "functions": {
    "api/index.ts": {
      "includeFiles": ["server.js", "*.pdf", "backend/*.pdf", "backend/**", "public/**", "frontend/public/**"]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/chat",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
