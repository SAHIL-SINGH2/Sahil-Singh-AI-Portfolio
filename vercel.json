{
  "functions": {
    "api/index.ts": {
      "includeFiles": ["server.js", "**/*.pdf", "public/**", "frontend/public/**", "backend/**"]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/chat",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
